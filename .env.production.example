# Настройки продакшен-стека (compose.prod.yaml). Скопируйте в .env на сервере.

APP_NAME="Task Manager API"
# Сгенерировать: docker run --rm ghcr.io/krisratman/rest-apilaravel php artisan key:generate --show
APP_KEY=
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com

# Порт API на хосте; наружу его открывает обратный прокси с TLS.
APP_PORT=8080
APP_BIND=127.0.0.1

DB_DATABASE=task_manager
DB_USERNAME=task_manager
DB_PASSWORD=
DB_ROOT_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com

# Лимиты, TTL кэша и даты устаревания v1 — см. .env.example и config/api.php.
